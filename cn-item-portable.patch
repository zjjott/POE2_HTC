+	{ "攻击", "Reaver" },
+	{ "施法", "Sibilant" },
+	{ "速度", "Skittering" },
+}
+
+local TAG = {
+	["攻击"] = "attack",
+	["法术"] = "caster",
+	["施法"] = "caster",
+	["生命"] = "life",
+	["魔力"] = "mana",
+	["火焰"] = "fire",
+	["冰霜"] = "cold",
+	["闪电"] = "lightning",
+	["混沌"] = "chaos",
+	["物理"] = "physical",
+}
+
+local ELEMENT = {
+	{ "冰霜", "Cold" },
+	{ "火焰", "Fire" },
+	{ "闪电", "Lightning" },
+	{ "混沌", "Chaos" },
+	{ "物理", "Physical" },
+}
+
+local ACCEPT = 0.75
+
+local baseList = {}
+for zh, names in pairs(cnLex.bases) do
+	t_insert(baseList, { zh = zh, names = names })
+end
+table.sort(baseList, function(a, b)
+	return #a.zh > #b.zh
+end)
+
+local function codepoints(s)
+	local t = {}
+	local i = 1
+	local n = #s
+	while i <= n do
+		local b = s:byte(i)
+		local len = 1
+		if b >= 0xF0 then
+			len = 4
+		elseif b >= 0xE0 then
+			len = 3
+		elseif b >= 0xC0 then
+			len = 2
+		end
+		t[#t + 1] = s:sub(i, i + len - 1)
+		i = i + len
+	end
+	return t
+end
+
+local function levenshtein(a, b)
+	local aa, bb = codepoints(a), codepoints(b)
+	local n, m = #aa, #bb
+	if n == 0 then return m end
+	if m == 0 then return n end
+	local prev = {}
+	for j = 0, m do prev[j] = j end
+	for i = 1, n do
+		local cur = { [0] = i }
+		for j = 1, m do
+			local cost = aa[i] == bb[j] and 0 or 1
+			cur[j] = m_min(cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + cost)
+		end
+		prev = cur
+	end
+	return prev[m]
+end
+
+local function similarity(a, b)
+	if a == b then return 1 end
+	local denom = m_max(#codepoints(a), #codepoints(b), 1)
+	return 1 - levenshtein(a, b) / denom
+end
+
+local function stripParens(s)
+	local out = {}
+	local i = 1
+	local n = #s
+	while i <= n do
+		local three = s:sub(i, i + 2)
+		if s:sub(i, i) == "(" or three == "（" then
+			local start = s:sub(i, i) == "(" and i + 1 or i + 3
+			local a = s:find(")", start, true)
+			local b = s:find("）", start, true)
+			local stop = a and b and m_min(a, b) or a or b
+			if not stop then
+				t_insert(out, s:sub(i))
+				break
+			end
+			i = s:sub(stop, stop + 2) == "）" and stop + 3 or stop + 1
+		else
+			t_insert(out, s:sub(i, i))
+			i = i + 1
+		end
+	end
+	return t_concat(out)
+end
+
+local function normLine(s)
+	s = stripParens(s)
+	s = s:gsub("＋", "+"):gsub("＃", "#"):gsub("％", "%%")
+	s = s:gsub("%+#", "#")
+	s = s:gsub("[%+%-]?%d+%.?%d*", "#")
+	s = s:gsub("#+", "#")
+	s = s:gsub("%s+", "")
+	return s:lower()
+end
+
+local function normText(text)
+	local parts = {}
+	for line in (text .. "\n"):gmatch("([^\n]*)\n") do
+		if line ~= "" then
+			local n = normLine(line)
+			if n ~= "" then
+				t_insert(parts, n)
+			end
+		end
+	end
+	return t_concat(parts, "|")
+end
+
+local function pobNorm(s)
+	s = s:gsub("%+?%(([%+%-]?%d+%.?%d*)%-([%+%-]?%d+%.?%d*)%)", "#")
+	return normText(s)
+end
+
+local function spansOf(text)
+	local spans = {}
+	local src = text:gsub("–", "-"):gsub("—", "-")
+	for lo, hi in src:gmatch("%(%s*([%+%-]?%d+%.?%d*)%s*%-%s*([%+%-]?%d+%.?%d*)%s*%)") do
+		t_insert(spans, { tonumber(lo), tonumber(hi) })
+	end
+	for lo, hi in src:gmatch("（%s*([%+%-]?%d+%.?%d*)%s*%-%s*([%+%-]?%d+%.?%d*)%s*）") do
+		t_insert(spans, { tonumber(lo), tonumber(hi) })
+	end
+	return spans
+end
+
+local function sameSpans(a, b)
+	if #a == 0 or #a ~= #b then return false end
+	for i, span in ipairs(a) do
+		if span[1] ~= b[i][1] or span[2] ~= b[i][2] then return false end
+	end
+	return true
+end
+
+local function rolledNumbers(lines)
+	local nums = {}
+	for _, line in ipairs(lines) do
+		local bare = stripParens(line)
+		for n in bare:gmatch("[%+%-]?%d+%.?%d*") do
+			t_insert(nums, n)
+		end
+	end
+	return nums
+end
+
+local function fillEnglish(template, nums)
+	local out = {}
+	local i = 0
+	local pos = 1
+	while pos <= #template do
+		if template:sub(pos, pos + 1) == "+#" then
+			i = i + 1
+			local num = nums[i] or "#"
+			if num:sub(1, 1) ~= "+" and num:sub(1, 1) ~= "-" then
+				num = "+" .. num
+			end
+			t_insert(out, num)
+			pos = pos + 2
+		elseif template:sub(pos, pos) == "#" then
+			i = i + 1
+			local num = nums[i] or "#"
+			t_insert(out, (num:gsub("^%+", "")))
+			pos = pos + 1
+		else
+			t_insert(out, template:sub(pos, pos))
+			pos = pos + 1
+		end
+	end
+	return t_concat(out)
+end
+
+local function spanText(template, spans)
+	local i = 0
+	local out = {}
+	local pos = 1
+	while pos <= #template do
+		if template:sub(pos, pos + 1) == "+#" or template:sub(pos, pos) == "#" then
+			local plus = template:sub(pos, pos + 1) == "+#"
+			i = i + 1
+			local span = spans[i]
+			if span then
+				local shown = span[1] .. "-" .. span[2]
+				t_insert(out, plus and "+(" .. shown .. ")" or "(" .. shown .. ")")
+			else
+				t_insert(out, plus and "+#" or "#")
+			end
+			pos = pos + (plus and 2 or 1)
+		else
+			t_insert(out, template:sub(pos, pos))
+			pos = pos + 1
+		end
+	end
+	return t_concat(out)
+end
+
+local function fmtRange(n)
+	local s = s_format("%.3f", math.floor(n * 1000 + 0.5) / 1000)
+	s = s:gsub("0+$", ""):gsub("%.$", "")
+	return s
+end
+
+local function splitLines(s)
+	local rows = {}
+	for line in (s .. "\n"):gmatch("([^\n]*)\n") do
+		if line ~= "" then
+			t_insert(rows, line)
+		end
+	end
+	return rows
+end
+
+local function sliders(spans, nums)
+	local values = {}
+	for i, span in ipairs(spans) do
+		local roll = tonumber((nums[i] or ""):gsub("^%+", ""))
+		local v = 0.5
+		if roll and span[2] ~= span[1] then
+			v = m_min(1, m_max(0, (roll - span[1]) / (span[2] - span[1])))
+		end
+		t_insert(values, fmtRange(v))
+	end
+	if #values == 0 then return "0.5" end
+	return t_concat(values, ",")
+end
+
+local function quoted(body)
+	local _, ae = body:find('"', 1, true)
+	if ae then
+		local cs = body:find('"', ae + 1, true)
+		if cs then return body:sub(ae + 1, cs - 1) end
+	end
+	_, ae = body:find("“", 1, true)
+	if ae then
+		local cs = body:find("”", ae + 1, true)
+		if cs then return body:sub(ae + 1, cs - 1) end
+	end
+end
+
+local function headerTags(body)
+	local dash = body:find("—", 1, true) or body:find("–", 1, true)
+	if not dash then return {} end
+	local rest = body:sub(dash + 3)
+	if body:sub(dash, dash + 2) ~= "—" and body:sub(dash, dash + 2) ~= "–" then
+		rest = body:sub(dash + 1)
+	end
+	-- Drop every em dash so "魔力——提高" does not become extra tags.
+	rest = rest:gsub("—", ""):gsub("–", "")
+	local tags = {}
+	for part in (rest .. ","):gmatch("([^,，]+)") do
+		part = part:gsub("^%s+", ""):gsub("%s+$", ""):gsub("}", "")
+		if part ~= "" then
+			local mapped = TAG[part]
+			if mapped then t_insert(tags, mapped) end
+		end
+	end
+	return tags
+end
+
+local function parseHeader(line)
+	local t = line:match("^%s*(.-)%s*$")
+	if t:sub(1, 1) ~= "{" or t:sub(-1) ~= "}" then return nil end
+	local body = t:sub(2, -2):gsub("^%s+", ""):gsub("%s+$", "")
+	local desecrated, crafted, implicit = false, false, false
+	while true do
+		if body:sub(1, #"亵渎的") == "亵渎的" then
+			desecrated = true
+			body = body:sub(#"亵渎的" + 1):gsub("^%s+", "")
+		elseif body:sub(1, #"打造的") == "打造的" then
+			crafted = true
+			body = body:sub(#"打造的" + 1):gsub("^%s+", "")
+		elseif body:sub(1, #"基底属性") == "基底属性" then
+			implicit = true
+			body = body:sub(#"基底属性" + 1):gsub("^%s+", "")
+		else
+			break
+		end
+	end
+	local kind = "unknown"
+	if body:sub(1, #"前缀属性") == "前缀属性" then kind = "prefix"
+	elseif body:sub(1, #"后缀属性") == "后缀属性" then kind = "suffix"
+	elseif body:sub(1, #"腐化强化") == "腐化强化" then kind = "corrupted"
+	elseif body:sub(1, #"符文") == "符文" then kind = "rune" end
+	local tier = body:match("等阶%s*:%s*(%d+)") or body:match("等阶%s*：%s*(%d+)")
+	return {
+		desecrated = desecrated,
+		crafted = crafted,
+		implicit = implicit,
+		kind = kind,
+		tierName = quoted(body),
+		displayTier = tier and tonumber(tier) or nil,
+		tags = headerTags(body),
+		raw = t,
+	}
+end
+
+local function catalystOf(label)
+	local best, name
+	for _, row in ipairs(CATALYST) do
+		if label:find(row[1], 1, true) and (not best or #row[1] > #best) then
+			best, name = row[1], row[2]
+		end
+	end
+	return name
+end
+
+local function afterLabel(s, name)
+	if s:sub(1, #name) ~= name then return nil end
+	local rest = s:sub(#name + 1):gsub("^%s+", "")
+	if rest:sub(1, 1) == ":" then return rest:sub(2):gsub("^%s+", "") end
+	if rest:sub(1, 3) == "：" then return rest:sub(4):gsub("^%s+", "") end
+end
+
+local function takeProp(line, props)
+	local s = line:match("^%s*(.-)%s*$")
+	if s == "被腐化" or s == "已腐化" or s == "腐化" then
+		props.corrupted = true
+		return true
+	end
+	if s == "引路石掉落" then return true end
+	if afterLabel(s, "物品类别") or afterLabel(s, "物品种类") then return true end
+	local rarity = afterLabel(s, "稀有度")
+	if rarity then
+		props.rarity = RARITY[rarity] or rarity
+		return true
+	end
+	local ilvl = afterLabel(s, "物品等级")
+	if ilvl then
+		props.itemLevel = tonumber(ilvl:match("%d+"))
+		return true
+	end
+	local qualityLabel = afterLabel(s, "品质")
+	local catRest = s:sub(1, #"品质") == "品质" and s:sub(#"品质" + 1) or nil
+	local catLabel = catRest and (catRest:match("^%s*（%s*(.-)%s*）") or catRest:match("^%s*%(%s*(.-)%s*%)"))
+	if catLabel then
+		local value = catRest:match("([%+%-]?%d+)")
+		local name = catalystOf(catLabel)
+		if name and value then
+			props.catalyst = name
+			props.catalystQuality = tonumber(value)
+		else
+			t_insert(props.notes, "No catalyst name for " .. catLabel)
+		end
+		return true
+	end
+	if qualityLabel then
+		props.quality = qualityLabel:match("[%+%-]?%d+%.?%d*")
+		return true
+	end
+	return false
+end
+
+local function isSeparator(line)
+	return line == "" or line:match("^%-+$") ~= nil
+end
+
+local function parseBlocks(text)
+	local props = { corrupted = false, notes = {} }
+	local blocks = {}
+	local names = {}
+	local seenSep = false
+	local current
+	local function flush()
+		if not current then return end
+		if #current.lines > 0 or current.header then
+			local runeTag = false
+			for _, line in ipairs(current.lines) do
+				if line:match("%(rune%)%s*$") then runeTag = true end
+			end
+			t_insert(blocks, { header = current.header, lines = current.lines, runeTag = runeTag })
+		end
+		current = nil
+	end
+	text = text:gsub("^\239\187\191", ""):gsub("\r\n", "\n"):gsub("\r", "\n")
+	for raw in (text .. "\n"):gmatch("([^\n]*)\n") do
+		local line = raw:match("^%s*(.-)%s*$")
+		if isSeparator(line) then
+			seenSep = true
+			flush()
+		else
+			local header = parseHeader(line)
+			if header then
+				flush()
+				current = { header = header, lines = {} }
+			elseif takeProp(line, props) then
+				flush()
+			elseif not seenSep and not current and #names < 2 and not line:find("%d") and not line:find("获得技能", 1, true) then
+				t_insert(names, line)
+			else
+				if not current then current = { lines = {} } end
+				t_insert(current.lines, line)
+			end
+		end
+	end
+	flush()
+	return blocks, props, names
+end
+
+local function spawnWeight(base, mod)
+	if not base or not mod.weightKey then return 0, false end
+	local weight = 0
+	local matched = false
+	for i, key in ipairs(mod.weightKey) do
+		if base.tags[key] then
+			weight = mod.weightVal[i]
+			matched = true
+			break
+		end
+	end
+	for i, key in ipairs(mod.weightMultiplierKey or {}) do
+		if base.tags[key] then
+			weight = weight * mod.weightMultiplierVal[i] / 100
+			break
+		end
+	end
+	return weight, matched
+end
+
+local function modLines(mod)
+	local lines = {}
+	for _, line in ipairs(mod) do
+		if type(line) == "string" then
+			t_insert(lines, line)
+		end
+	end
+	return lines
+end
+
+local function resolveBase(names)
+	for _, line in ipairs(names) do
+		for _, row in ipairs(baseList) do
+			if line == row.zh then
+				local found = {}
+				for _, name in ipairs(row.names) do
+					if data.itemBases[name] then
+						t_insert(found, name)
+					end
+				end
+				if #found == 1 then
+					return data.itemBases[found[1]], found[1]
+				end
+			end
+		end
+	end
+	local best, bestScore
+	local tie = false
+	for _, line in ipairs(names) do
+		local s = normLine(line)
+		if #codepoints(s) >= 2 then
+			for _, row in ipairs(baseList) do
+				local score = similarity(s, normLine(row.zh))
+				if score >= ACCEPT then
+					if best and math.abs(score - bestScore) < 0.01 and best.zh ~= row.zh then
+						tie = true
+					elseif not best or score > bestScore then
+						best, bestScore, tie = row, score, false
+					end
+				end
+			end
+		end
+	end
+	if not best or tie then return nil end
+	local found = {}
+	for _, name in ipairs(best.names) do
+		if data.itemBases[name] then
+			t_insert(found, name)
+		end
+	end
+	if #found == 1 then
+		return data.itemBases[found[1]], found[1]
+	end
+end
+
+local function filterEnglish(list, statText)
+	local want = #splitLines(statText)
+	local kept = {}
+	for _, english in ipairs(list) do
+		if #splitLines(english) == want then
+			t_insert(kept, english)
+		end
+	end
+	if #kept > 0 then return kept end
+	return list
+end
+
+local function phraseEnglish(text)
+	local key = normText(text)
+	local exact = cnLex.phrases[key]
+	if exact then return exact end
+	local best, bestScore, tie
+	for candidate, english in pairs(cnLex.phrases) do
+		local score = similarity(key, candidate)
+		if score >= ACCEPT then
+			if best and math.abs(score - bestScore) < 0.01 then
+				tie = true
+			elseif not best or score > bestScore then
+				best, bestScore, tie = english, score, false
+			end
+		end
+	end
+	if best and not tie then return best end
+end
+
+local function elementWord(header)
+	if not header then return nil end
+	local blob = t_concat(header.tags, ",")
+	-- header.tags are already English. The raw header is checked below.
+	for _, row in ipairs(ELEMENT) do
+		if header.raw:find(row[1], 1, true) then
+			return row[2]
+		end
+	end
+	return blob ~= "" and nil or nil
+end
+
+local function affixTables(base, header, runeTag)
+	local tables = {}
+	if runeTag or (header and header.kind == "rune") then
+		return tables
+	end
+	if header and header.desecrated and data.itemMods.Desecrated then
+		t_insert(tables, data.itemMods.Desecrated)
+	end
+	if header and header.kind == "corrupted" and data.itemMods.Corruption then
+		t_insert(tables, data.itemMods.Corruption)
+	end
+	local typed = data.itemMods[base.type]
+	if typed then t_insert(tables, typed) end
+	if typed ~= data.itemMods.Item then
+		t_insert(tables, data.itemMods.Item)
+	end
+	return tables
+end
+
+local function pickMod(base, header, englishList, spans)
+	local hits, fallback = {}, {}
+	for _, english in ipairs(englishList) do
+		local want = pobNorm(english)
+		for _, tbl in ipairs(affixTables(base, header, false)) do
+			for modId, mod in pairs(tbl) do
+				local lines = modLines(mod)
+				if #lines > 0 and pobNorm(t_concat(lines, "\n")) == want then
+					local side = mod.type and mod.type:lower() or nil
+					local sideOk = not header or header.kind ~= "prefix" and header.kind ~= "suffix" or side == header.kind
+					local spanOk = #spans == 0 or sameSpans(spans, spansOf(t_concat(lines, "\n")))
+					local weight, matched = spawnWeight(base, mod)
+					if sideOk and spanOk and matched then
+						t_insert(weight > 0 and hits or fallback, { id = modId, english = english, mod = mod })
+					end
+				end
+			end
+		end
+	end
+	if #hits == 0 then hits = fallback end
+	if #hits > 1 then
+		local word = elementWord(header)
+		if word then
+			local narrowed = {}
+			for _, hit in ipairs(hits) do
+				if hit.english:find(word, 1, true) then
+					t_insert(narrowed, hit)
+				end
+			end
+			if #narrowed > 0 then hits = narrowed end
+		end
+	end
+	if #hits == 1 then return hits[1] end
+	return nil, #hits
+end
+
+local function cleanLines(lines)
+	local out = {}
+	for _, line in ipairs(lines) do
+		t_insert(out, (line:gsub("%s*%(rune%)%s*$", "")))
+	end
+	return out
+end
+
+function CnItem.LooksLike(text)
+	if type(text) ~= "string" then return false end
+	if not text:find("{", 1, true) then return false end
+	return text:find("前缀属性", 1, true) or text:find("后缀属性", 1, true)
+		or text:find("基底属性", 1, true) or text:find("腐化强化", 1, true)
+		or text:find("符文", 1, true)
+end
+
+function CnItem.ToCrafted(text)
+	local blocks, props, names = parseBlocks(text)
+	local notes = {}
+	for _, note in ipairs(props.notes) do
+		t_insert(notes, note)
+	end
+	local base, baseName = resolveBase(names)
+	if not base then
+		t_insert(notes, "No English base for: " .. (#names > 0 and t_concat(names, " / ") or "(none)"))
+		return nil, notes
+	end
+	local affix, implicitRows, explicitRows = {}, {}, {}
+	for _, block in ipairs(blocks) do
+		local rawLines = block.lines
+		local joined = t_concat(rawLines, "\n")
+		if #rawLines == 0 then
+			t_insert(notes, "Header without a stat line")
+		elseif joined:find("获得技能", 1, true) then
+			t_insert(notes, "Unmatched granted skill: " .. joined:gsub("\n", " / "))
+		elseif not block.header and not block.runeTag and not joined:find("%d") then
+			-- Socket reminder and other prose.
+		else
+			local statLines = cleanLines(rawLines)
+			local statText = t_concat(statLines, "\n")
+			local englishList = phraseEnglish(statText)
+			if englishList then
+				englishList = filterEnglish(englishList, statText)
+			end
+			local header = block.header
+			local implicit = header and header.implicit or block.runeTag or (header and header.kind == "rune")
+			if not englishList then
+				t_insert(notes, "Unmatched: " .. joined:gsub("\n", " / "))
+			elseif implicit and #englishList ~= 1 then
+				t_insert(notes, "Several lines match: " .. joined:gsub("\n", " / "))
+			elseif implicit then
+				local spans = spansOf(statText)
+				local nums = rolledNumbers(statLines)
+				local body = #spans > 0 and spanText(englishList[1], spans) or fillEnglish(englishList[1], nums)
+				local tags = header and header.tags or {}
+				local prefix = ""
+				if #tags > 0 then prefix = "{tags:" .. t_concat(tags, ",") .. "}" end
+				if #spans > 0 then prefix = prefix .. "{range:" .. sliders(spans, nums) .. "}" end
+				if block.runeTag or (header and header.kind == "rune") then prefix = "{rune}" .. prefix end
+				for n, row in ipairs(splitLines(body)) do
+					t_insert(implicitRows, n == 1 and prefix .. row or row)
+				end
+			else
+				local spans = spansOf(statText)
+				local hit, count = pickMod(base, header, englishList, spans)
+				if not hit then
+					local why = count and count > 1 and "several mods match" or "no mod matches"
+					t_insert(notes, why .. ": " .. joined:gsub("\n", " / "))
+				else
+					local nums = rolledNumbers(statLines)
+					local side = hit.mod.type == "Suffix" and "Suffix" or "Prefix"
+					t_insert(affix, side .. ": {range:" .. sliders(spans, nums) .. "}" .. hit.id)
+					local filled = fillEnglish(hit.english, nums)
+					local flag = header and header.desecrated and "{desecrated}" or ""
+					for _, row in ipairs(splitLines(filled)) do
+						t_insert(explicitRows, flag .. row)
+					end
+				end
+			end
+		end
+	end
+	local rarity = props.rarity or "RARE"
+	local lines = { "Rarity: " .. rarity:sub(1, 1) .. rarity:sub(2):lower() }
+	if rarity ~= "NORMAL" and rarity ~= "MAGIC" then
+		t_insert(lines, base.type)
+	end
+	t_insert(lines, baseName)
+	t_insert(lines, "Crafted: true")
+	for _, line in ipairs(affix) do
+		t_insert(lines, line)
+	end
+	if props.catalyst then
+		t_insert(lines, "Catalyst: " .. props.catalyst)
+		if props.catalystQuality then
+			t_insert(lines, "CatalystQuality: " .. props.catalystQuality)
+		end
+	elseif props.quality then
+		t_insert(lines, "Quality: " .. props.quality)
+	end
+	if props.itemLevel then
+		t_insert(lines, "Item Level: " .. props.itemLevel)
+	end
+	t_insert(lines, "Implicits: " .. #implicitRows)
+	for _, line in ipairs(implicitRows) do
+		t_insert(lines, line)
+	end
+	for _, line in ipairs(explicitRows) do
+		t_insert(lines, line)
+	end
+	if props.corrupted then
+		t_insert(lines, "Corrupted")
+	end
+	return t_concat(lines, "\n"), notes
+end
+
+return CnItem
