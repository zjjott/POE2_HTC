+-- Path of Building
+--
+-- Module: Chinese item import
+-- Brace-headed text from the Chinese client, such as `{ 前缀属性 "权威的" (等阶：1) }`,
+-- into the crafted item text Item:ParseRaw already reads.
+-- The rare name is not kept. Stat phrases come from Data/CnLex.lua.
+
+local m_min = math.min
+local m_max = math.max
+local s_format = string.format
+local t_insert = table.insert
+local t_concat = table.concat
+
+local cnLex = LoadModule("Data/CnLex")
+
+local CnItem = {}
+
